# DDump config (loaded first, then overridden by ~/Library/Application Support/DDump/config.env)
#
# DDump is a Mac auto-importer for camera/SD cards. Insert a card → it detects
# photos → copies them to a local staging folder → optionally uploads them to a
# cloud destination → ejects the card. Designed to be photographer-agnostic:
# every behavior is controlled by the variables below.

# ================================================================
# Destination
# ================================================================

# Local staging folder where files are copied first.
DEST_ROOT="$HOME/Temp"

# Create a daily subfolder inside DEST_ROOT (e.g. /Temp/2026-05-19-ddump).
CREATE_DAILY_FOLDER="1"
DAILY_FOLDER_FORMAT="%Y-%m-%d-ddump"

# After staging + eject, copy imported folders to a final destination.
# Leave blank to disable. Staging is intentionally kept as the local backup;
# Safe Cleanup is the only built-in flow that removes old staging folders.
ENABLE_POST_EJECT_MOVE="1"
POST_MOVE_ROOT=""
POST_MOVE_ROOTS=""
POST_MOVE_FALLBACK_ROOT=""

# Subpath template under POST_MOVE_ROOT. strftime-style; gets joined per day.
# Default: YYYY/YYYY.MM/YYYY.MM.DD/<shoot-folder>
POST_MOVE_YEAR_FORMAT="%Y"
POST_MOVE_MONTH_FORMAT="%Y.%m"
POST_MOVE_DAY_FORMAT="%Y.%m.%d"

# Require POST_MOVE_ROOT to be reachable + writable before attempting move.
POST_MOVE_REQUIRE_READY="1"

# Cloud mount package settings. Leave disabled unless the user turns on cloud
# uploads in the app's Cloud settings.
CLOUD_UPLOADS_ENABLED="0"
GDRIVE_MOUNT_ENABLED="0"
GDRIVE_DIRECT_UPLOAD="0"
GDRIVE_MOUNT_POINT="$HOME/GoogleDrive"
GDRIVE_REMOTE="combined:"
RCLONE_BIN="$HOME/bin/rclone"
RCLONE_CACHE_DIR="$HOME/Library/Application Support/DDump/cache/rclone"
RCLONE_MOUNT_COMMAND="auto"
RCLONE_FILE_TIMEOUT_SECONDS="180"
RCLONE_BATCH_TIMEOUT_SECONDS="3600"
RCLONE_DRIVE_CHUNK_SIZE="8M"
RCLONE_TPS_LIMIT="2"
RCLONE_TPS_BURST="2"
GDRIVE_MOUNT_LABEL="com.ddump.rclone-gdrive"
GDRIVE_MOUNT_RETRY_SECONDS="15,30,60,180"
GDRIVE_MOUNT_WAIT_SECONDS="30"
GDRIVE_ACTION_TIMEOUT_SECONDS="180"
CLOUD_IDLE_UNMOUNT_SECONDS="180"
PREVENT_FINDER_NETWORK_METADATA="1"
GOOGLE_DRIVE_DESKTOP_ENABLED="1"
GOOGLE_DRIVE_DESKTOP_RESTART_ON_FAILURE="1"
GOOGLE_DRIVE_DESKTOP_RESTART_DELAY_SECONDS="5"
GOOGLE_DRIVE_DESKTOP_APP_NAME="Google Drive"
GOOGLE_DRIVE_DESKTOP_APP_PATH="/Applications/Google Drive.app"
NETWORK_RESUME_ENABLED="1"
NETWORK_RESUME_CHECK_SECONDS="20"
NETWORK_RESUME_COOLDOWN_SECONDS="120"

# Refuse to start a card import unless local staging has at least this much
# free disk space. Set to 0 to disable.
MIN_FREE_SPACE_GB="100"

# ================================================================
# Folder naming strategy
# ================================================================
#
# How to NAME the shoot folder inside the day folder. Options:
#
#   template    - build folder names from tokens like
#                 {smart_camera} - {calendar_event} - {date_ymd}. This is the
#                 most flexible mode for mixed cameras, drones, weddings, etc.
#
#   calendar    - look up calendar events for the import date and group files by
#                 overlapping event. Folder name = event title. Files outside
#                 any event window fall through to FOLDER_NAMING_FALLBACK.
#
#   sequential  - "Dump 1", "Dump 2", "Dump 3"... auto-numbered, resets daily.
#                 Useful for travel photographers — just keep dumping cards.
#                 Configurable prefix via FOLDER_NAME_SEQUENTIAL_PREFIX.
#
#   custom      - cycle through FOLDER_NAME_CUSTOM_VALUES (comma-separated) in order.
#                 "Event 1,Event 2,Wedding,Reception" → first import "Event 1", next "Event 2", etc.
#                 Useful for event photographers with known shoot names that day.
#
#   cluster     - time-cluster files: each gap larger than CLUSTER_GAP_MINUTES
#                 starts a new cluster. Folder name = "Cluster HH:MM-HH:MM".
#                 Useful when you don't have a calendar / don't want to plan ahead.
#
#   smart       - infer the final date-folder structure from SMART_SAMPLE_PATH,
#                 then group by time clusters. If today's Drive date folder already
#                 contains shoot folders, cluster 1 maps to the first folder,
#                 cluster 2 to the second, etc.
#
#   camera      - use the camera's raw folder names from the card (e.g. "101EOSR7").
#                 This is what DDump v1 did. Cheapest, dumbest.
#
FOLDER_NAMING_STRATEGY="sequential"

# When the primary strategy fails (calendar gap, custom list exhausted, etc.):
FOLDER_NAMING_FALLBACK="cluster"

# Prefix for "sequential" strategy.
FOLDER_NAME_SEQUENTIAL_PREFIX="Shoot-"

# When DDump wraps imported files in a shoot/calendar bucket, keep destination
# folders flat by default. Set to 1 only if you explicitly want camera/source
# folder paths like Shoot Name/DCIM/104_2026/file.CR3 inside each shoot bucket.
REBUCKET_PRESERVE_SOURCE_FOLDERS="0"

# Template strategy. Use these when FOLDER_NAMING_STRATEGY="template".
# Common tokens:
#   {smart_camera}, {camera_brand}, {camera_make}, {camera_model},
#   {camera_model_short}, {calendar_event}, {shoot}, {cluster}, {date},
#   {date_ymd}, {date_yymmdd}, {year}, {month}, {day}, {time},
#   {folder}, {filename}, {sequence}, {sequence_3}, {total}, {lens},
#   {serial}, {artist}, {software}, {iso}, {focal_length}, {gps}
FOLDER_NAME_TEMPLATE="{smart_camera} - {shoot} - {date_ymd}"

# Smart camera label mode:
#   smart - shortest useful label; expands within a shoot only when needed
#   brand - brand only
#   model - simplified model only
#   full  - brand + simplified model
SMART_CAMERA_LABEL_MODE="smart"

# Optional filename replacement during the rebucket step. Extensions are
# preserved automatically. Uses the same tokens as FOLDER_NAME_TEMPLATE.
FILE_RENAME_ENABLED="0"
FILE_NAME_TEMPLATE="{filename}"

# Optional offline/default shoot label. When calendar naming has no event or
# internet is unavailable, template mode can still use this as {shoot}.
DEFAULT_SHOOT_NAME=""

# Cluster grouping is independent from naming strategy:
# when enabled, DDump groups nearby files by capture time first, then applies
# naming (for example Shoot-1, Shoot-2).
CLUSTER_GROUPING_ENABLED="1"

# Cross-card cluster attach window (minutes). A new card cluster within this
# time window of an existing same-day shoot bucket reuses that bucket name.
CLUSTER_ATTACH_MINUTES="120"

# Cycle values for "custom" strategy (comma-separated).
FOLDER_NAME_CUSTOM_VALUES=""

# Bucket name for files that match no strategy at all (calendar misses, etc.).
FOLDER_NAME_UNCATEGORIZED="Uncategorized"

# Smart naming sample path. Paste any real shoot folder path that includes:
#   .../YYYY/YYYY.MM/YYYY.MM.DD/Shoot Name
# Example:
#   /Users/<you>/GoogleDrive/Client Uploads/Photos/2026/2026.05/2026.05.19/Example Shoot
SMART_SAMPLE_PATH=""

# In smart mode, optionally map time clusters into existing named folders under
# today's final date folder. Default off because sorted-folder matching can
# mislabel shoots when someone else's folders already exist.
SMART_ASSIGN_EXISTING_FOLDERS="0"

# Optional split after import: photos stay under the configured/smart photo
# destination; video extensions go to the sibling smart path where "1 — Photo"
# is replaced with "2 — Video". Default off until you confirm the folder naming.
SPLIT_PHOTO_VIDEO="0"

# ================================================================
# Time clustering (for "cluster" strategy and as the universal fallback)
# ================================================================

# Gap between consecutive photos (in minutes) that triggers a new cluster.
# Smaller = more granular folders; larger = fewer/bigger folders.
CLUSTER_GAP_MINUTES="30"

# Folder name template for cluster strategy. Substitutions:
#   {n}       cluster sequence (1, 2, 3...)
#   {start}   cluster start time HH:MM
#   {end}     cluster end time HH:MM
CLUSTER_FOLDER_TEMPLATE="Cluster {n} {start}-{end}"

# ================================================================
# Calendar integration (for "calendar" strategy)
# ================================================================

# Provider used by the Calendar settings wizard:
#   none   - calendar naming is not connected
#   google - Google Calendar OAuth/helper
#   apple  - macOS Apple Calendar/EventKit
#   ics    - private read-only calendar link
CALENDAR_PROVIDER="none"

# Connection state shown in the app: authorized | pending | not_authorized | missing_helper.
CALENDAR_AUTH_STATUS="not_authorized"

# Google desktop OAuth client ID. The helper requests read-only Calendar access.
GOOGLE_CALENDAR_CLIENT_ID="570098546449-737pvkselaqtncp2e6kdmhkf55eemche.apps.googleusercontent.com"

# Google desktop OAuth client secret. This is part of the installed-app OAuth
# credential JSON; it is not a user password.
GOOGLE_CALENDAR_CLIENT_SECRET=""

# Optional private ICS/webcal URL for CALENDAR_PROVIDER=ics.
CALENDAR_ICS_URL=""

# Optional calendar display-name filter. Blank = all available calendars/primary source.
CALENDAR_NAME=""

# Pad each calendar event window by this many minutes on each side
# (catches setup/teardown shots before/after the official event time).
CALENDAR_EVENT_PADDING_MIN="15"

# If a photo cluster falls between calendar events, hold a main-screen question
# so the user can assign it to the previous event, next event, or a manual name.
CALENDAR_AMBIGUITY_PROMPTS_ENABLED="1"

# ================================================================
# Card detection
# ================================================================

# Volume name prefixes that are auto-trusted (comma-separated).
# A card named matching any prefix is treated as known + safe to import.
TRUSTED_NAME_PREFIXES=""

# File extensions that mean "this volume has photos" (comma-separated, no spaces, no leading dot).
PHOTO_FILE_EXTENSIONS="jpg,jpeg,heic,heif,cr2,cr3,nef,arw,raf,dng,rw2,orf,pef,srw,tif,tiff,mp4,mov,m4v,avi,mts,m2ts,3gp,3gpp,insv,insp,gpr"
VIDEO_FILE_EXTENSIONS="mp4,mov,m4v,avi,mts,m2ts,3gp,3gpp,insv,gpr"

# How many minutes back to look when describing "recent" photos in the
# detect notification ("X photos, Y from the last hour").
PHOTO_RECENCY_HOURS="24"

# When a new (untrusted) volume mounts, run a quick photo scan first.
# If the volume looks like a camera card, prompt the user. If it looks like an
# installer/update/app volume, silently skip it.
# Set "0" only if you want the script to consider EVERY mounted volume.
REQUIRE_PHOTOS_OR_TRUSTED="1"

# Card detection mode:
# - smart:   require camera-card shape, not just one stray image/video file
# - photos:  legacy behavior, any matching media file can prompt
# - off:     same as photos for compatibility; REQUIRE_PHOTOS_OR_TRUSTED gates use
CAMERA_CARD_DETECTION_MODE="smart"

# Unknown cards must have at least this many media files unless they have a
# camera-folder hint such as DCIM/PRIVATE/AVCHD. This avoids installer DMGs that
# happen to include screenshots or videos.
CAMERA_CARD_MIN_MEDIA_FILES="3"
CAMERA_CARD_SCAN_MAX_DEPTH="6"
CAMERA_CARD_HINT_DIRS="DCIM,PRIVATE,M4ROOT,CLIP,XDROOT,AVCHD,MP_ROOT,CANONMSC"
CAMERA_CARD_REJECT_INSTALLER_SHAPES="1"

# Candidate selection mode for import:
# - all:      scan all files on card, rely on hash dedupe
# - lookback: only scan files newer than LOOKBACK_HOURS
CANDIDATE_MODE="lookback"
LOOKBACK_HOURS="24"

# Optional source-folder convention. If the card has this subfolder, it's the default scan root.
# (For non-camera devices like drones, leave blank or set to your custom folder name.)
SOURCE_SUBDIR="DCIM"

# If no source folder is chosen, fall back to SOURCE_SUBDIR automatically.
SOURCE_SUBDIR_FALLBACK_ON_EMPTY_SELECTION="1"

# Skip macOS internal volumes (like Macintosh HD) unless explicitly trusted.
SKIP_INTERNAL_VOLUMES="1"

# Always ignore these volume names (comma-separated).
IGNORE_VOLUME_NAMES="Macintosh HD,Recovery"

# Ignore transient mounts with no Volume UUID (recovery helpers, etc.).
IGNORE_NO_UUID_VOLUMES="1"

# ================================================================
# Prompts
# ================================================================

# Optional advanced mode: on first encounter with a trusted card, prompt to
# choose one or more source folders. Default off; DDump scans the whole card
# for eligible media within the configured time window.
PROMPT_FOR_SOURCE_FOLDERS_ON_NEW_DRIVE="0"

# Bring the DDump app forward when a trusted card starts processing.
OPEN_APP_ON_CARD_INSERT="1"

# On first encounter with an unknown card that has photos, prompt:
# Trust + Import / Just this time / Skip / Never (UUID added to block list).
PROMPT_FOR_UNKNOWN_CARD_ACTION="1"

# Use native macOS notifications (top-right banner) instead of a terminal monitor window.
# 1 = recommended modern UX. 0 = open the legacy Terminal monitor.
USE_NOTIFICATIONS="1"

# How long the action-button notifications wait before timing out (seconds).
NOTIFICATION_TIMEOUT_SECONDS="60"

# ================================================================
# Eject + safety
# ================================================================

# Eject card on success.
EJECT_ON_SUCCESS="1"

# Maximum time to wait for macOS eject before continuing with upload.
EJECT_TIMEOUT_SECONDS="20"

# Minimum wait before auto-eject (any value below 60 is clamped to 60).
EJECT_GRACE_SECONDS="60"

# Finder server helper used to keep network/cloud mounts alive during uploads.
FINDERSERVER_BIN="$HOME/.local/bin/finderserver"

# While uploads are active, DDump checks the finderserver auto-off timer every N seconds.
FINDERSERVER_TIMER_CHECK_SECONDS="300"

# If the timer has this many seconds left (or less), DDump refreshes it (finderserver on).
FINDERSERVER_TIMER_MIN_SECONDS="300"

# ================================================================
# Copy verification
# ================================================================

VERIFY_COPIED_FILES="1"
VERIFY_COPY_HASH="0"
USE_FAST_SEEN_INDEX="1"
MANIFEST_RETENTION_DAYS="0"
MISSED_REPORT_MAX_ROWS="5000"
WRITE_DAILY_DIGEST="1"
UPLOAD_RECEIPTS_ENABLED="1"

# SQLite database memory. This replaces fragile "search the text files forever"
# behavior with durable job/file/upload status tables.
DB_ENABLED="0"
DB_FILE="$HOME/Library/Application Support/DDump/state/ddump.sqlite3"

# Keep SD-card eject fast: default does NOT hash the card before copying.
# Size verification still happens before eject. If set to 1, DDump reads every
# SD-card file once for SHA-256 before copy, which is slower.
HASH_BEFORE_COPY="0"

# Pending upload retry delays. Failed uploads wait 3m, 10m, 60m, then 240m
# between attempts. The LaunchAgent wakes periodically; this schedule prevents
# hammering Google Drive in a destructive retry loop.
UPLOAD_RETRY_MINUTES="3,10,60,240"

# Safe Cleanup in the Mac app only offers staging folders older than this many
# days, and moves them to Trash instead of permanently deleting.
SAFE_CLEANUP_DAYS="7"

# Optional Slack webhook for admin-only run notifications. Treat the URL like a
# password: anyone who has it can post into that Slack channel.
SLACK_WEBHOOK_URL=""
SLACK_NOTIFY_ON_COMPLETE="0"
SLACK_NOTIFY_ON_ERROR="1"

# Optional ntfy topic for mobile push notifications.
NTFY_TOPIC=""

# Per-event ntfy toggles:
# staging_started, card_ejected, upload_started, upload_complete.
# Defaults: card_ejected + upload_complete ON. Mount-failure alerts are OFF because
# cloud mounts are intentionally short lived and retried from the app.
NTFY_NOTIFY_STAGING_STARTED="0"
NTFY_NOTIFY_CARD_EJECTED="1"
NTFY_NOTIFY_UPLOAD_STARTED="0"
NTFY_NOTIFY_UPLOAD_COMPLETE="1"
NTFY_NOTIFY_MOUNT_FAILED="0"
NTFY_NOTIFY_CARD_ALMOST_FULL="1"
NTFY_NOTIFY_INTEGRITY_WARNING="1"
NTFY_NOTIFY_PENDING_RECOVERY_MISSING="1"
MACOS_NOTIFY_STAGING_STARTED="1"
MACOS_NOTIFY_CARD_EJECTED="1"
MACOS_NOTIFY_UPLOAD_STARTED="1"
MACOS_NOTIFY_UPLOAD_COMPLETE="1"
MACOS_NOTIFY_MOUNT_FAILED="0"
MACOS_NOTIFY_CARD_ALMOST_FULL="1"
MACOS_NOTIFY_INTEGRITY_WARNING="1"
MACOS_NOTIFY_PENDING_RECOVERY_MISSING="1"
NTFY_TEMPLATE_STAGING_STARTED="{message}"
NTFY_TEMPLATE_CARD_EJECTED="{message}"
NTFY_TEMPLATE_UPLOAD_STARTED="{message}"
NTFY_TEMPLATE_UPLOAD_COMPLETE="{message}"
NTFY_TEMPLATE_MOUNT_FAILED="{message}"
NTFY_TEMPLATE_CARD_ALMOST_FULL="{message}"
NTFY_TEMPLATE_INTEGRITY_WARNING="{message}"
NTFY_TEMPLATE_PENDING_RECOVERY_MISSING="{import_time} import is missing {missing_count} of {total_count} items. Please reinsert the same card to retry."
CARD_ALMOST_FULL_ALERT_ENABLED="1"

# App appearance: system | light | dark
APP_COLOR_SCHEME="system"
APP_ICON_DEFAULT_LIGHT=""
APP_ICON_DEFAULT_DARK=""

# First-run wizard. Set back to 0 to show the starter setup again.
ONBOARDING_COMPLETED="0"

# Public release update checks. Disabled by default. When enabled, DDump checks
# GitHub Releases and can open the download page for a newer DMG.
UPDATE_CHECKS_ENABLED="0"
AUTO_UPDATES_ENABLED="0"
UPDATE_CHECK_FREQUENCY="weekly"
UPDATE_GITHUB_REPO="chaserobertsonn/ddump"
WINDOW_RESTORE_MODE="remember"

# Optional extension filter at import time (blank = import every file type).
FILE_EXTENSIONS=""

# ================================================================
# Legacy / deprecated UI
# ================================================================

# The Terminal-window progress monitor that v1 used.
# Off by default in v2 (notifications are the primary UX). Set to 1 for debugging.
SHOW_PROGRESS_WINDOW="0"

# A modal "Do Not Eject" dialog at the start of each run. Off by default; the
# unified notification UX handles keep/eject as inline action buttons.
PROMPT_NO_EJECT_ON_START="0"

# End-of-run modal dialog. Off by default.
SHOW_RUN_SUMMARY_DIALOG="0"
SUMMARY_DIALOG_TIMEOUT_SECONDS="20"

# Legacy notification toggle for the old `notify` helper (osascript). Now unused
# when USE_NOTIFICATIONS=1.
ENABLE_NOTIFICATIONS="0"
