# DDump config (loaded first, then overridden by ~/Library/Application Support/DDump/config.env)
#
# DDump is a Mac auto-importer for camera/SD cards. Insert a card → it detects
# photos → copies them to a local staging folder → optionally uploads them to a
# cloud destination → ejects the card. Designed to be photographer-agnostic:
# every behavior is controlled by the variables below.

# ================================================================
# Destination
# ================================================================

# Local staging folder where files are copied first.
DEST_ROOT="$HOME/Temp"

# Create a daily subfolder inside DEST_ROOT (e.g. /Temp/2026-05-19-ddump).
CREATE_DAILY_FOLDER="1"
DAILY_FOLDER_FORMAT="%Y-%m-%d-ddump"

# After staging + eject, move imported folders to a final destination.
# Leave blank to disable (files stay in DEST_ROOT).
ENABLE_POST_EJECT_MOVE="1"
POST_MOVE_ROOT=""

# Subpath template under POST_MOVE_ROOT. strftime-style; gets joined per day.
# Default: YYYY/YYYY.MM/YYYY.MM.DD/<shoot-folder>
POST_MOVE_YEAR_FORMAT="%Y"
POST_MOVE_MONTH_FORMAT="%Y.%m"
POST_MOVE_DAY_FORMAT="%Y.%m.%d"

# Require POST_MOVE_ROOT to be reachable + writable before attempting move.
POST_MOVE_REQUIRE_READY="1"

# Refuse to start a card import unless local staging has at least this much
# free disk space. Set to 0 to disable.
MIN_FREE_SPACE_GB="100"

# ================================================================
# Folder naming strategy
# ================================================================
#
# How to NAME the shoot folder inside the day folder. Options:
#
#   calendar    - look up Google Calendar events for the import date and
#                 group files by overlapping event. Folder name = event title.
#                 Files outside any event window fall through to FOLDER_NAMING_FALLBACK.
#                 Requires gcalcli installed + authenticated.
#
#   sequential  - "Dump 1", "Dump 2", "Dump 3"... auto-numbered, resets daily.
#                 Useful for travel photographers — just keep dumping cards.
#                 Configurable prefix via FOLDER_NAME_SEQUENTIAL_PREFIX.
#
#   custom      - cycle through FOLDER_NAME_CUSTOM_VALUES (comma-separated) in order.
#                 "Event 1,Event 2,Wedding,Reception" → first import "Event 1", next "Event 2", etc.
#                 Useful for event photographers with known shoot names that day.
#
#   cluster     - time-cluster files: each gap larger than CLUSTER_GAP_MINUTES
#                 starts a new cluster. Folder name = "Cluster HH:MM-HH:MM".
#                 Useful when you don't have a calendar / don't want to plan ahead.
#
#   smart       - infer the final date-folder structure from SMART_SAMPLE_PATH,
#                 then group by time clusters. If today's Drive date folder already
#                 contains shoot folders, cluster 1 maps to the first folder,
#                 cluster 2 to the second, etc.
#
#   camera      - use the camera's raw folder names from the card (e.g. "101EOSR7").
#                 This is what DDump v1 did. Cheapest, dumbest.
#
FOLDER_NAMING_STRATEGY="cluster"

# When the primary strategy fails (calendar gap, custom list exhausted, etc.):
FOLDER_NAMING_FALLBACK="cluster"

# Prefix for "sequential" strategy.
FOLDER_NAME_SEQUENTIAL_PREFIX="DDump "

# Cycle values for "custom" strategy (comma-separated).
FOLDER_NAME_CUSTOM_VALUES=""

# Bucket name for files that match no strategy at all (calendar misses, etc.).
FOLDER_NAME_UNCATEGORIZED="Uncategorized"

# Smart naming sample path. Paste any real shoot folder path that includes:
#   .../YYYY/YYYY.MM/YYYY.MM.DD/Shoot Name
# Example:
#   /Users/chaserobertson/GoogleDrive/Densley/1 — Media/1 — Uploads/1 — Photo/2026/2026.05/2026.05.19/Amy Jaten - 6638 S Milfoil Cir, West Jordan, UT 84081
SMART_SAMPLE_PATH=""

# In smart mode, if today's final date folder already has named shoot folders,
# map time clusters into those existing folders by sorted order.
SMART_ASSIGN_EXISTING_FOLDERS="1"

# Optional split after import: photos stay under the configured/smart photo
# destination; video extensions go to the sibling smart path where "1 — Photo"
# is replaced with "2 — Video". Default off until you confirm the folder naming.
SPLIT_PHOTO_VIDEO="0"

# ================================================================
# Time clustering (for "cluster" strategy and as the universal fallback)
# ================================================================

# Gap between consecutive photos (in minutes) that triggers a new cluster.
# Smaller = more granular folders; larger = fewer/bigger folders.
CLUSTER_GAP_MINUTES="45"

# Folder name template for cluster strategy. Substitutions:
#   {n}       cluster sequence (1, 2, 3...)
#   {start}   cluster start time HH:MM
#   {end}     cluster end time HH:MM
CLUSTER_FOLDER_TEMPLATE="Cluster {n} {start}-{end}"

# ================================================================
# Calendar integration (for "calendar" strategy)
# ================================================================

# Blank = primary calendar. Otherwise the calendar's display name as gcalcli sees it.
CALENDAR_NAME=""

# Pad each calendar event window by this many minutes on each side
# (catches setup/teardown shots before/after the official event time).
CALENDAR_EVENT_PADDING_MIN="15"

# ================================================================
# Card detection
# ================================================================

# Volume name prefixes that are auto-trusted (comma-separated).
# A card named matching any prefix is treated as known + safe to import.
TRUSTED_NAME_PREFIXES="DFP_"

# File extensions that mean "this volume has photos" (comma-separated, no spaces, no leading dot).
PHOTO_FILE_EXTENSIONS="jpg,jpeg,heic,heif,cr2,cr3,nef,arw,raf,dng,rw2,orf,pef,srw,tif,tiff,mp4,mov,m4v,avi,mts,m2ts,3gp,3gpp,insv,insp,gpr"
VIDEO_FILE_EXTENSIONS="mp4,mov,m4v,avi,mts,m2ts,3gp,3gpp,insv,gpr"

# How many minutes back to look when describing "recent" photos in the
# detect notification ("X photos, Y from the last hour").
PHOTO_RECENCY_HOURS="24"

# When a new (untrusted) volume mounts, run a quick photo scan first.
# If the volume has photo files, prompt the user. If it has none, silent skip.
# Set "0" only if you want the script to consider EVERY mounted volume.
REQUIRE_PHOTOS_OR_TRUSTED="1"

# Candidate selection mode for import:
# - all:      scan all files on card, rely on hash dedupe (safer; default)
# - lookback: only scan files newer than LOOKBACK_HOURS
CANDIDATE_MODE="all"
LOOKBACK_HOURS="24"

# Optional source-folder convention. If the card has this subfolder, it's the default scan root.
# (For non-camera devices like drones, leave blank or set to your custom folder name.)
SOURCE_SUBDIR="DCIM"

# If no source folder is chosen, fall back to SOURCE_SUBDIR automatically.
SOURCE_SUBDIR_FALLBACK_ON_EMPTY_SELECTION="1"

# Skip macOS internal volumes (like Macintosh HD) unless explicitly trusted.
SKIP_INTERNAL_VOLUMES="1"

# Always ignore these volume names (comma-separated).
IGNORE_VOLUME_NAMES="Macintosh HD,Recovery"

# Ignore transient mounts with no Volume UUID (recovery helpers, etc.).
IGNORE_NO_UUID_VOLUMES="1"

# ================================================================
# Prompts
# ================================================================

# On first encounter with a trusted-by-prefix card, prompt to choose one or more source folders.
# The choices are remembered per card UUID for future runs.
PROMPT_FOR_SOURCE_FOLDERS_ON_NEW_DRIVE="1"

# On first encounter with an unknown card that has photos, prompt:
# Trust + Import / Just this time / Skip / Never (UUID added to block list).
PROMPT_FOR_UNKNOWN_CARD_ACTION="1"

# Use native macOS notifications (top-right banner) instead of a terminal monitor window.
# 1 = recommended modern UX. 0 = open the legacy Terminal monitor.
USE_NOTIFICATIONS="1"

# How long the action-button notifications wait before timing out (seconds).
NOTIFICATION_TIMEOUT_SECONDS="60"

# ================================================================
# Eject + safety
# ================================================================

# Eject card on success.
EJECT_ON_SUCCESS="1"

# Minimum wait before auto-eject (any value below 60 is clamped to 60).
EJECT_GRACE_SECONDS="60"

# Finder server helper used to keep the DFP + Google Drive mounts alive during uploads.
FINDERSERVER_BIN="$HOME/.local/bin/finderserver"

# While uploads are active, DDump checks the finderserver auto-off timer every N seconds.
FINDERSERVER_TIMER_CHECK_SECONDS="300"

# If the timer has this many seconds left (or less), DDump refreshes it (finderserver on).
FINDERSERVER_TIMER_MIN_SECONDS="300"

# ================================================================
# Copy verification
# ================================================================

VERIFY_COPIED_FILES="1"
VERIFY_COPY_HASH="0"
USE_FAST_SEEN_INDEX="1"
MANIFEST_RETENTION_DAYS="0"
MISSED_REPORT_MAX_ROWS="5000"
WRITE_DAILY_DIGEST="1"
UPLOAD_RECEIPTS_ENABLED="1"

# SQLite database memory. This replaces fragile "search the text files forever"
# behavior with durable job/file/upload status tables.
DB_ENABLED="1"
DB_FILE="$HOME/Library/Application Support/DDump/state/ddump.sqlite3"

# Keep SD-card eject fast: default does NOT hash the card before copying.
# Size verification still happens before eject. If set to 1, DDump reads every
# SD-card file once for SHA-256 before copy, which is slower.
HASH_BEFORE_COPY="0"

# Pending upload retry delays. Failed uploads wait 3m, 10m, 60m, then 240m
# between attempts. The LaunchAgent wakes periodically; this schedule prevents
# hammering Google Drive in a destructive retry loop.
UPLOAD_RETRY_MINUTES="3,10,60,240"

# Safe Cleanup in the Mac app only offers staging folders older than this many
# days, and moves them to Trash instead of permanently deleting.
SAFE_CLEANUP_DAYS="7"

# Optional Slack webhook for admin-only run notifications. Treat the URL like a
# password: anyone who has it can post into that Slack channel.
SLACK_WEBHOOK_URL=""
SLACK_NOTIFY_ON_COMPLETE="0"
SLACK_NOTIFY_ON_ERROR="1"

# Optional extension filter at import time (blank = import every file type).
FILE_EXTENSIONS=""

# ================================================================
# Legacy / deprecated UI
# ================================================================

# The Terminal-window progress monitor that v1 used.
# Off by default in v2 (notifications are the primary UX). Set to 1 for debugging.
SHOW_PROGRESS_WINDOW="0"

# A modal "Do Not Eject" dialog at the start of each run. Off by default; the
# unified notification UX handles keep/eject as inline action buttons.
PROMPT_NO_EJECT_ON_START="0"

# End-of-run modal dialog. Off by default.
SHOW_RUN_SUMMARY_DIALOG="0"
SUMMARY_DIALOG_TIMEOUT_SECONDS="20"

# Legacy notification toggle for the old `notify` helper (osascript). Now unused
# when USE_NOTIFICATIONS=1.
ENABLE_NOTIFICATIONS="0"
