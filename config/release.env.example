# DDump release automation example environment.
# Copy values into your shell only for local dry runs. Do not put real secrets in this file.

DDUMP_VERSION=0.4.0
DDUMP_BUILD=400
DDUMP_CHANNEL=beta
DDUMP_SOURCE_SHA=0000000000000000000000000000000000000000
DDUMP_PREVIOUS_KNOWN_GOOD_VERSION=0.3.18
DDUMP_PHASED_ROLLOUT_INTERVAL=0
DDUMP_RELEASE_NOTES_URL=https://downloads.ddump.app/beta/0.4.0/release-notes.html
DDUMP_SPARKLE_PUBLIC_ED_KEY=

# Non-secret paid-launch client configuration (test by default):
DDUMP_PAID_ENVIRONMENT=test
DDUMP_SUPABASE_URL=
DDUMP_SUPABASE_PUBLISHABLE_KEY=
DDUMP_ENTITLEMENT_ISSUER=https://api.ddump.app
DDUMP_ENTITLEMENT_AUDIENCE=com.ddump.app
DDUMP_ENTITLEMENT_PUBLIC_KEYS=
DDUMP_CHECK_EMAIL_URL=https://ddump.app/account/check-email

DDUMP_DOWNLOADS_BASE_URL=https://downloads.ddump.app
DDUMP_UPDATES_BASE_URL=https://updates.ddump.app
DDUMP_REQUIRED_CHECKS=build-and-package

# Local static/build dry run:
#   DDUMP_SKIP_MAC_BUILD=1 ./scripts/public-readiness-check.sh
#   bash -n scripts/release/*.sh
#   python3 - <<'PY'
#   from pathlib import Path
#   for path in Path("scripts/release").glob("*.py"):
#       compile(path.read_text(encoding="utf-8"), str(path), "exec")
#   PY
#   ./scripts/release/verify-action-pins.sh .github/workflows

# Protected release-beta signing secrets, set only in GitHub Environment secrets:
DDUMP_DEVELOPER_ID_APPLICATION_IDENTITY=
DDUMP_DEVELOPER_ID_APPLICATION_CERT_P12_B64=
DDUMP_DEVELOPER_ID_APPLICATION_CERT_PASSWORD=
DDUMP_NOTARYTOOL_KEY_ID=
DDUMP_NOTARYTOOL_ISSUER_ID=
DDUMP_NOTARYTOOL_PRIVATE_KEY_P8_B64=
DDUMP_SPARKLE_EDDSA_PRIVATE_KEY_B64=
DDUMP_RELEASE_AUTH_PRIVATE_KEY_B64=
DDUMP_RELEASE_AUTH_PUBLIC_KEY_B64=

# Protected release-beta R2 secrets:
DDUMP_R2_ACCOUNT_ID=
DDUMP_R2_RELEASE_BUCKET=
DDUMP_R2_BETA_ACCESS_KEY_ID=
DDUMP_R2_BETA_SECRET_ACCESS_KEY=

# Protected release-stable R2 secrets:
DDUMP_R2_STABLE_ACCESS_KEY_ID=
DDUMP_R2_STABLE_SECRET_ACCESS_KEY=

# Promotion-only evidence values:
DDUMP_BETA_ROLLOUT=named-internal-testers
DDUMP_RELEASE_NOTES_APPROVED=false
DDUMP_STABLE_ROLLOUT=0-percent
DDUMP_BETA_EVIDENCE_URL=
DDUMP_STABLE_APPROVAL_NOTES=
DDUMP_ROLLBACK_READY=0
DDUMP_FORWARD_FIX_READY=0
